<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jets.chat.server.admin.controller.ChangePasswordController"
      spacing="30" styleClass="content-area">

    <Label text="Change Password" styleClass="section-title"/>

    <GridPane hgap="25" vgap="20" alignment="CENTER_LEFT">
        <Label text="Current Password:" GridPane.rowIndex="0" GridPane.columnIndex="0"
               styleClass="form-label"/>
        <PasswordField fx:id="currentPasswordField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       promptText="Enter current password" styleClass="form-field" prefWidth="320"/>

        <Label text="New Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"
               styleClass="form-label"/>
        <PasswordField fx:id="newPasswordField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       promptText="Enter new password (min 8 chars)" styleClass="form-field" prefWidth="320"/>

        <Label text="Confirm Password:" GridPane.rowIndex="2" GridPane.columnIndex="0"
               styleClass="form-label"/>
        <PasswordField fx:id="confirmPasswordField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       promptText="Confirm new password" styleClass="form-field" prefWidth="320"/>
    </GridPane>

    <Label fx:id="statusLabel" text="" visible="false" wrapText="true"
           style="-fx-font-size: 15px; -fx-padding: 12px; -fx-border-radius: 8px;"/>

    <HBox spacing="20" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 14px 35px; -fx-background-radius: 10px;"/>
        <Button fx:id="changeBtn" text="Change Password" onAction="#changePassword"
                styleClass="action-button" style="-fx-padding: 14px 40px; -fx-font-size: 16px;"/>
    </HBox>

</VBox>