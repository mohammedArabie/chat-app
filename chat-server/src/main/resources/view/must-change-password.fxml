<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>


<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.jets.chat.server.admin.controller.MustChangePasswordController"
           style="-fx-background-color: #f0f2f5;">

    <VBox spacing="25" alignment="CENTER" maxWidth="500" maxHeight="600"
          style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <VBox spacing="10" alignment="CENTER">
            <Label text="Security Update" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Please set a new password for your first login" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
        </VBox>

        <VBox spacing="15">
            <VBox spacing="5">
                <Label text="Current Password" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                <PasswordField fx:id="currentPasswordField" promptText="••••••••"
                               style="-fx-background-radius: 5; -fx-padding: 10;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="New Password" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                <PasswordField fx:id="newPasswordField" promptText="Min. 8 characters"
                               style="-fx-background-radius: 5; -fx-padding: 10;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Confirm New Password" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm passwords match"
                               style="-fx-background-radius: 5; -fx-padding: 10;"/>
            </VBox>
        </VBox>

        <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true"
               style="-fx-padding: 10; -fx-background-radius: 5; -fx-font-size: 13px;"/>

        <HBox spacing="15" alignment="CENTER">
            <Button text="Reset" onAction="#handleCancel"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-cursor: hand;"/>
            <Button text="Update &amp; Continue" onAction="#changePassword" defaultButton="true"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</StackPane>