<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jets.chat.server.admin.controller.AdminDashboardController"
            stylesheets="@../style/admin-style.css"
            styleClass="dashboard-bg">

    <!-- ===================== TOP BAR ===================== -->
    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: white;
                     -fx-padding: 18px;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0.5, 0, 3);">

            <Label text="Chat Server Admin Dashboard"
                   style="-fx-text-fill: #2c3e50;
                          -fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-padding: 0 0 0 25px;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- ===== Server Control Area ===== -->
            <HBox spacing="12" alignment="CENTER">

                <!-- Status Indicator -->
                <HBox spacing="6" alignment="CENTER">
                    <Label fx:id="serverStatus"
                           text="●"
                           style="-fx-font-size: 22px;"/>

                    <Label fx:id="serverStatusLabel"
                           text="Running"
                           styleClass="running"
                           style="-fx-font-size: 16px;
                                  -fx-font-weight: bold;"/>
                </HBox>

                <!-- Start / Stop Button -->
                <Button fx:id="serverControlBtn"
                        text="Stop Server"
                        onAction="#toggleServer"
                        styleClass="server-running"
                        style="-fx-padding: 12px 25px;
                               -fx-font-size: 16px;
                               -fx-background-radius: 8px;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Logout Button -->
            <Button text="Logout"
                    onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-padding: 12px 25px;
                           -fx-background-radius: 8px;
                           -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- ===================== LEFT MENU ===================== -->
    <left>
        <VBox minWidth="250"
              spacing="12"
              style="-fx-background-color: #2c3e50;
                     -fx-padding: 35px 0 25px 0;">

            <Label text="MAIN MENU"
                   style="-fx-text-fill: #bdc3c7;
                          -fx-font-size: 14px;
                          -fx-padding: 0 0 20px 35px;
                          -fx-font-weight: bold;"/>

            <Button text="📊 Statistics"
                    fx:id="statsBtn"
                    onAction="#showStatistics"
                    styleClass="nav-button"/>

            <Button text="👥 User Management"
                    fx:id="userMgmtBtn"
                    onAction="#showUserManagement"
                    styleClass="nav-button"/>

            <Button text="👑 Add Admin"
                    fx:id="addAdminBtn"
                    onAction="#showAddAdmin"
                    styleClass="nav-button"/>

            <Button text="🔑 Change Password"
                    fx:id="pwdBtn"
                    onAction="#showChangePassword"
                    styleClass="nav-button"/>
            <Button text="📢 Send Announcement" onAction="#showAnnouncement"
                    styleClass="nav-button" fx:id="announceBtn"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="adminInfo"
                   text="Admin: superadmin"
                   style="-fx-text-fill: rgba(255,255,255,0.9);
                          -fx-font-size: 16px;
                          -fx-padding: 20px 35px 15px 35px;
                          -fx-font-weight: bold;"/>
        </VBox>
    </left>

    <!-- ===================== CONTENT ===================== -->
    <center>
        <StackPane fx:id="contentArea"
                   styleClass="content-area"/>
    </center>

</BorderPane>
