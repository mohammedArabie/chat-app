<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jets.chat.server.admin.controller.UserManagementController"
      spacing="25" styleClass="content-area"
      stylesheets="@../style/admin-style.css">

    <Label text="User Management" styleClass="section-title"/>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search users by name, phone or email..."
                   styleClass="search-box" HBox.hgrow="ALWAYS" onKeyReleased="#handleSearch"/>
        <Button text="Refresh" onAction="#handleRefresh"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 10px 20px; -fx-background-radius: 8px;"/>
    </HBox>

    <!-- REMOVED hardcoded columns - they're created in controller -->
    <TableView fx:id="usersTable" styleClass="data-table" VBox.vgrow="ALWAYS"
               editable="true">
        <!-- Columns are created dynamically in setupTable() method -->
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Label text="Total Users:" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
        <Label fx:id="totalUsersLabel" text="0" style="-fx-font-size: 18px; -fx-text-fill: #3498db; -fx-font-weight: bold;"/>
        <Label text=" / " style="-fx-font-size: 16px;"/>
        <Label text="Online:" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
        <Label fx:id="onlineUsersLabel" text="0" style="-fx-font-size: 18px; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
    </HBox>
</VBox>