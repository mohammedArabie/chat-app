<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jets.chat.server.admin.controller.AddAdminController"
      spacing="30" styleClass="content-area">

    <Label text="Add New Admin" styleClass="section-title"/>

    <GridPane hgap="25" vgap="20" alignment="CENTER_LEFT">
        <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"
               styleClass="form-label"/>
        <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                   promptText="Enter username (min 3 characters)"
                   styleClass="form-field" prefWidth="320"/>

        <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"
               styleClass="form-label"/>
        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
            <TextField fx:id="passwordField" promptText="Auto-generated password"
                       styleClass="form-field" prefWidth="230" editable="false"/>
            <Button fx:id="regenerateBtn" text="Generate New" onAction="#regeneratePassword"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 15px; -fx-background-radius: 8px;"/>
        </HBox>
    </GridPane>

    <Label fx:id="statusLabel" text="" visible="false" wrapText="true"
           style="-fx-font-size: 15px; -fx-padding: 12px; -fx-border-radius: 8px;"/>

    <HBox spacing="20" alignment="CENTER_RIGHT">
        <Button text="Clear" onAction="#handleCancel"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 14px 35px; -fx-background-radius: 10px;"/>
        <Button fx:id="createBtn" text="Create Admin" onAction="#createAdmin"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 14px 40px; -fx-background-radius: 10px; -fx-font-weight: bold;"/>
    </HBox>

</VBox>