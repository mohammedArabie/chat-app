<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jets.chat.client.controller.ProfileStatusController"
      spacing="15" style="-fx-padding: 0 10 0 10;">
    <Text text="%label.status" styleClass="section-title"/>
    <GridPane hgap="10" vgap="10">
        <ToggleButton fx:id="onlineBtn" text="%status.online" GridPane.columnIndex="0" GridPane.rowIndex="0"
                      prefWidth="180" prefHeight="45" styleClass="status-button"><font><Font size="14"/></font></ToggleButton>
        <ToggleButton fx:id="awayBtn" text="%status.away" GridPane.columnIndex="1" GridPane.rowIndex="0"
                      prefWidth="180" prefHeight="45" styleClass="status-button"><font><Font size="14"/></font></ToggleButton>
        <ToggleButton fx:id="dndBtn" text="%status.dnd" GridPane.columnIndex="0" GridPane.rowIndex="1"
                      prefWidth="180" prefHeight="45" styleClass="status-button"><font><Font size="14"/></font></ToggleButton>
        <ToggleButton fx:id="offlineBtn" text="%status.offline" GridPane.columnIndex="1" GridPane.rowIndex="1"
                      prefWidth="180" prefHeight="45" styleClass="status-button"><font><Font size="14"/></font></ToggleButton>
    </GridPane>
</VBox>