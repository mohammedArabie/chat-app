<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<VBox fx:id="sideBarRoot" prefWidth="300.0" spacing="10.0" styleClass="sidebar"
      stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jets.chat.client.ui.controllers.SideBarController">
    <children>
        <!-- User Profile Header -->
        <!-- User Profile Header -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <!-- Placeholder for User Avatar -->
                <Circle fx:id="userAvatar" fill="#4a90e2" radius="20.0" stroke="TRANSPARENT"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                    <children>
                        <!-- Notification/Requests Icon -->
                        <StackPane onMouseClicked="#onRequestsClicked" styleClass="icon-container">
                            <Region styleClass="svg-icon, icon-requests"/>
                            <Circle fx:id="requestBadge" fill="#ff4757" radius="7.0" StackPane.alignment="TOP_RIGHT">
                                <StackPane.margin>
                                    <Insets right="-3.0" top="-3.0"/>
                                </StackPane.margin>
                            </Circle>
                            <Label fx:id="requestCount" styleClass="badge-text" text="3"
                                   StackPane.alignment="TOP_RIGHT">
                                <StackPane.margin>
                                    <Insets right="0.0" top="-4.0"/>
                                </StackPane.margin>
                            </Label>
                        </StackPane>

                        <!-- Add Contact Icon -->
                        <Button onAction="#onAddContactClicked" styleClass="icon-btn-circle">
                            <graphic>
                                <Region styleClass="svg-icon, icon-add-user"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Add Contact"/>
                            </tooltip>
                        </Button>

                        <!-- Create Group Icon -->
                        <Button onAction="#onCreateGroupClicked" styleClass="icon-btn-circle">
                            <graphic>
                                <Region styleClass="svg-icon, icon-group"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Create Group"/>
                            </tooltip>
                        </Button>

                        <!-- Settings Icon -->
                        <Button onAction="#onSettingsClicked" styleClass="icon-btn-circle">
                            <graphic>
                                <Region styleClass="svg-icon, icon-settings"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Settings"/>
                            </tooltip>
                        </Button>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="5.0" right="5.0" top="5.0"/>
            </padding>
        </HBox>

        <!-- Search Field -->
        <TextField fx:id="searchField" promptText="Search conversations..." styleClass="search-bar">
            <VBox.margin>
                <Insets bottom="5.0" top="5.0"/>
            </VBox.margin>
        </TextField>

        <!-- Section Label -->
        <Label styleClass="section-header" text="MESSAGES">
            <VBox.margin>
                <Insets left="5.0" top="10.0"/>
            </VBox.margin>
        </Label>

        <!-- Contact List -->
        <ListView fx:id="contactListView" VBox.vgrow="ALWAYS" styleClass="custom-list-view"/>

    </children>
    <padding>
        <Insets bottom="10.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</VBox>