<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="chatAreaRoot" spacing="0.0" styleClass="chat-area"
      stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jets.chat.client.ui.controllers.ChatController">
    <children>
        <!-- Chat Header -->
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" styleClass="chat-header">
            <children>
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label fx:id="chatNameLabel" styleClass="chat-title" text="Select a conversation" />
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label fx:id="statusDotLabel" text="●" style="-fx-font-size: 10;" />
                            <Label fx:id="statusTextLabel" text="Offline" style="-fx-font-size: 11; -fx-text-fill: #8E9297;" />
                        </HBox>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" styleClass="icon-btn" text="📞" />
                        <Button mnemonicParsing="false" styleClass="icon-btn" text="📹" />
                        <Button mnemonicParsing="false" styleClass="icon-btn" text="⋮" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets left="25.0" right="25.0" />
            </padding>
        </HBox>

        <!-- Message History List -->
        <ListView fx:id="messageListView" styleClass="message-list-view" VBox.vgrow="ALWAYS" />

        <!-- Message Input Area -->
        <HBox alignment="CENTER" prefHeight="80.0" spacing="15.0" styleClass="input-area">
            <children>
                <!-- Attachment Button -->
                <Button fx:id="attachButton" mnemonicParsing="false" onAction="#onAttachFile"
                        styleClass="attach-button" text="📎">
                    <HBox.margin>
                        <Insets />
                    </HBox.margin>
                </Button>

                <TextField fx:id="messageInput" onAction="#onSendMessage"
                           promptText="Type a message..." styleClass="search-bar"
                           HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                    </padding>
                </TextField>

                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#onSendMessage"
                        prefHeight="38.0" prefWidth="80.0"
                        style="-fx-background-color: #0084FF; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="Send" />
            </children>
            <padding>
                <Insets left="25.0" right="25.0" />
            </padding>
        </HBox>
    </children>
</VBox>